# Template for a real .env.prod — copied and filled in, never committed.
# Used with: docker compose -f docker-compose.prod.yml --env-file .env.prod ...
#
# Nothing here is a real credential. Every value must be replaced before
# this stack is ever exposed to the internet.

# --- Environment ---
# "test" for a staging-like rehearsal (what this phase's local verification
# uses), "production" for the real thing. Never "dev" outside a developer's
# own machine — see apps/server/src/app-environment.ts.
APP_ENV=test

# --- Postgres (also read directly by the `postgres` service in
# docker-compose.prod.yml to initialize the database) ---
DB_NAME=vendure
DB_USERNAME=vendure
DB_PASSWORD=replace-with-a-strong-password
DB_SCHEMA=public

# --- Vendure core ---
VENDURE_SERVER_PORT=3000
COOKIE_SECRET=replace-with-a-random-secret
SUPERADMIN_USERNAME=replace-with-an-admin-username
SUPERADMIN_PASSWORD=replace-with-a-strong-password

# --- Reverse proxy / domains (read by the `caddy` service, see Caddyfile) ---
# Must both have DNS A/AAAA records pointing at this server before starting
# the stack — Caddy requests Let's Encrypt certs for these on first startup.
# See DOCKER_PRODUCTION.md.
PUBLIC_DOMAIN=tienda.example.com
API_DOMAIN=api.tienda.example.com
# Email Let's Encrypt may contact about certificate issues. Any address works.
CADDY_EMAIL=admin@example.com

# --- CORS / assets (see apps/server/src/production-safety.ts) ---
# Must be the storefront's real public URL(s), comma-separated if more than one.
CORS_ORIGIN=https://tienda.example.com
# Must be reachable by whoever loads it: the Dashboard admin's browser, and
# (for the storefront's own image proxying) the storefront container itself —
# a single public API_DOMAIN behind the proxy satisfies both.
ASSET_URL_PREFIX=https://api.tienda.example.com/assets/

# --- Redsys (TPV Virtual) ---
# The values below are Redsys' own publicly documented sandbox/test
# merchant — safe to use as-is against sis-t.redsys.es while
# REDSYS_ENVIRONMENT=test. Replace all four with real values (from your bank)
# only when REDSYS_ENVIRONMENT=production.
REDSYS_MERCHANT_CODE=999008881
REDSYS_TERMINAL=1
REDSYS_SECRET_KEY=sq7HjrUOBfKmC576ILgskD5srU870gJ7
REDSYS_ENVIRONMENT=test
# Must be reachable from the public internet in real production — Redsys'
# servers POST the payment result here directly. For local verification,
# Redsys can't reach a local container at all, so payment settlement is
# simulated (see the Fase 15 report).
REDSYS_NOTIFICATION_URL=https://api.tienda.example.com/payments/redsys/notify
STOREFRONT_URL=https://tienda.example.com

# --- Invoicing ---
# The store's real, registered fiscal identity — confirm with a tax advisor
# before relying on this for real invoices (see InvoicingPlugin's doc comment).
INVOICE_STORE_NAME=Tienda Suple
INVOICE_STORE_TAX_ID=B00000000
INVOICE_STORE_ADDRESS=Calle Ejemplo 1, 28001 Madrid, España
INVOICE_STORE_EMAIL=facturacion@example.com
# Optional — shown on invoices only when set.
INVOICE_STORE_PHONE=
# Registro Mercantil data, printed on invoices (mandatory for companies, e.g. an S.L.;
# leave empty for a self-employed owner). E.g. "Inscrita en el R.M. de Madrid, Tomo 1, Folio 2, Hoja M-3"
INVOICE_STORE_REGISTRY=

# --- Transactional email ---
# "dev" never sends anything real; switch to "smtp" + the SMTP_* vars for
# actual delivery. Leaving this as "dev" in a real production deploy means
# verification/password-reset emails silently never reach customers — see
# apps/server/src/production-safety.ts's startup warning for this.
EMAIL_ENABLED=true
EMAIL_PROVIDER=dev
EMAIL_FROM="Iron Savage <no-reply@example.com>"
# Brand name shown in emails (subjects, greeting, footer). Defaults to INVOICE_STORE_NAME.
EMAIL_STORE_NAME=Iron Savage
EMAIL_REPLY_TO=soporte@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# --- Storefront ---
NEXT_PUBLIC_SITE_URL=https://tienda.example.com
NEXT_PUBLIC_SITE_NAME=Iron Savage
# Google Analytics 4: measurement ID of the GA4 web data stream (G-XXXXXXXXXX).
# Leave empty to disable analytics completely. Baked in at build time: rebuild
# the storefront image after changing it. Only loads after cookie consent.
NEXT_PUBLIC_GA_ID=
VENDURE_CHANNEL_TOKEN=__default_channel__
REVALIDATION_SECRET=replace-with-a-random-secret
