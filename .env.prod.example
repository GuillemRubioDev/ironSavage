# Plantilla del .env.prod real: se copia y se rellena; nunca se sube al repo.
# Se usa con: docker compose -f docker-compose.prod.yml --env-file .env.prod ...
#
# Nada de esto es una credencial real. Hay que sustituir todos los valores
# antes de exponer el sistema a internet.

# --- Entorno ---
# "test" para un ensayo tipo preproducción (el que se usó en la verificación
# local), "production" para el entorno real. Nunca "dev" fuera del equipo de
# un desarrollador; ver apps/server/src/app-environment.ts.
APP_ENV=test

# --- Postgres (también los lee directamente el servicio `postgres` de
# docker-compose.prod.yml para inicializar la base de datos) ---
DB_NAME=vendure
DB_USERNAME=vendure
DB_PASSWORD=replace-with-a-strong-password
DB_SCHEMA=public

# --- Núcleo de Vendure ---
VENDURE_SERVER_PORT=3000
COOKIE_SECRET=replace-with-a-random-secret
SUPERADMIN_USERNAME=replace-with-an-admin-username
SUPERADMIN_PASSWORD=replace-with-a-strong-password

# --- Proxy inverso / dominios (los lee el servicio `caddy`, ver Caddyfile) ---
# Los dos deben tener registros DNS A/AAAA apuntando a este servidor antes de
# arrancar: Caddy pide los certificados de Let's Encrypt en el primer arranque.
# Ver DOCKER_PRODUCTION.md.
PUBLIC_DOMAIN=tienda.example.com
API_DOMAIN=api.tienda.example.com
# Email al que Let's Encrypt puede avisar de problemas con el certificado. Vale cualquiera.
CADDY_EMAIL=admin@example.com

# --- CORS / recursos (ver apps/server/src/production-safety.ts) ---
# URL pública real de la tienda; si hay varias, separadas por comas.
CORS_ORIGIN=https://tienda.example.com
# Debe ser accesible para quien la cargue: el navegador del administrador del
# dashboard y (para el proxy de imágenes de la tienda) el propio contenedor del
# storefront. Un único API_DOMAIN público detrás del proxy cubre ambos casos.
ASSET_URL_PREFIX=https://api.tienda.example.com/assets/

# --- Redsys (TPV Virtual) ---
# Estos valores son el comercio de pruebas que Redsys publica en su
# documentación: se pueden usar tal cual contra sis-t.redsys.es mientras
# REDSYS_ENVIRONMENT=test. Sustituye los cuatro por los reales (los da el banco)
# solo cuando REDSYS_ENVIRONMENT=production.
REDSYS_MERCHANT_CODE=999008881
REDSYS_TERMINAL=1
REDSYS_SECRET_KEY=sq7HjrUOBfKmC576ILgskD5srU870gJ7
REDSYS_ENVIRONMENT=test
# En producción debe ser accesible desde internet: los servidores de Redsys
# envían aquí el resultado del pago (POST). En local Redsys no puede llegar a
# un contenedor, así que la confirmación del pago se simula (ver el informe de
# la Fase 15).
REDSYS_NOTIFICATION_URL=https://api.tienda.example.com/payments/redsys/notify
STOREFRONT_URL=https://tienda.example.com

# --- Facturación ---
# Identidad fiscal real y registrada de la tienda. Confírmala con la gestoría
# antes de emitir facturas reales (ver el comentario de InvoicingPlugin).
INVOICE_STORE_NAME=Tienda Suple
INVOICE_STORE_TAX_ID=B00000000
INVOICE_STORE_ADDRESS=Calle Ejemplo 1, 28001 Madrid, España
INVOICE_STORE_EMAIL=facturacion@example.com
# Opcional: solo aparece en la factura si se rellena.
INVOICE_STORE_PHONE=
# Datos del Registro Mercantil, impresos en las facturas (obligatorio en sociedades, p. ej. una S.L.;
# vacío si es autónomo). P. ej. "Inscrita en el R.M. de Madrid, Tomo 1, Folio 2, Hoja M-3"
INVOICE_STORE_REGISTRY=

# --- Emails automáticos ---
# "dev" no envía nada real; para enviar de verdad, pon "smtp" y las variables
# SMTP_*. Dejar "dev" en producción significa que los emails de verificación y
# de recuperar contraseña no llegan nunca a los clientes, sin ningún error (ver
# el aviso de arranque en apps/server/src/production-safety.ts).
EMAIL_ENABLED=true
EMAIL_PROVIDER=dev
EMAIL_FROM="Iron Savage <no-reply@example.com>"
# Nombre comercial en los emails (asuntos, saludo, pie). Por defecto, INVOICE_STORE_NAME.
EMAIL_STORE_NAME=Iron Savage
EMAIL_REPLY_TO=soporte@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# --- Tienda (storefront) ---
NEXT_PUBLIC_SITE_URL=https://tienda.example.com
NEXT_PUBLIC_SITE_NAME=Iron Savage
# Google Analytics 4: ID de medición del flujo de datos web de GA4 (G-XXXXXXXXXX).
# Vacío = sin analítica. Se incrusta al compilar: reconstruye la imagen del
# storefront tras cambiarlo. Solo se carga tras aceptar las cookies.
NEXT_PUBLIC_GA_ID=
VENDURE_CHANNEL_TOKEN=__default_channel__
REVALIDATION_SECRET=replace-with-a-random-secret
