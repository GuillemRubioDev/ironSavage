# Proxy inverso de producción. Caddy gestiona HTTPS solo: los dominios públicos
# reales (PUBLIC_DOMAIN/API_DOMAIN) reciben certificados de Let's Encrypt con
# renovación automática y redirección HTTP->HTTPS; los nombres locales o no
# públicos (p. ej. localhost, *.localhost) usan automáticamente la CA interna de
# Caddy. No hace falta otra configuración para desarrollo; ver DOCKER_PRODUCTION.md.
#
# {$VAR} es la sustitución de variables de entorno del propio Caddyfile; se
# resuelve con el `environment:` del servicio `caddy` en docker-compose.prod.yml.

{
	email {$CADDY_EMAIL}
}

# Se aplica a los dos sitios de abajo: compresión zstd/gzip (ni el servidor
# Next.js del storefront ni vendure-server comprimen por su cuenta; ver la sección
# «Rendimiento» de PRODUCTION_OPERATIONS.md) y un conjunto prudente de cabeceras
# de seguridad que se pueden poner en el proxy sin conocer cada origen de
# scripts/estilos (HSTS, MIME-sniffing, clickjacking, fuga de referrer,
# funciones antiguas del navegador). La Content-Security-Policy NO se pone aquí
# a propósito: una CSP errónea rompe la app sin avisar (bloquea scripts, estilos
# o imágenes) y debe redactarse con los orígenes reales de cada app. El
# storefront ya envía la suya (apps/storefront/src/proxy.ts).
(common_headers) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

{$PUBLIC_DOMAIN} {
	import common_headers
	# Registro de accesos por stdout (se ve con `docker logs caddy`). Es el único
	# sitio donde se ve un 502 (storefront o vendure-server caídos), porque la
	# petición nunca llega a ellos. El filtro `query` quita el parámetro `token`
	# antes de escribirlo: /verify y /reset-password reciben el token de
	# verificación o de contraseña como `?token=...`, y nunca debe acabar en los logs.
	log {
		format filter {
			wrap console
			fields {
				request>uri query {
					delete token
				}
			}
		}
	}
	reverse_proxy storefront:3001
}

{$API_DOMAIN} {
	import common_headers
	log {
		format filter {
			wrap console
			fields {
				request>uri query {
					delete token
				}
			}
		}
	}
	reverse_proxy vendure-server:3000
}
