DB_PASSWORD=replace-with-a-strong-password
DB_SCHEMA=public

# --- Redsys (TPV Virtual) ---
# Never put real production credentials here or in a committed .env file.
# The values below are Redsys' own publicly documented sandbox/test merchant,
# safe to use as-is against sis-t.redsys.es while REDSYS_ENVIRONMENT=test.
REDSYS_MERCHANT_CODE=999008881
REDSYS_TERMINAL=1
REDSYS_SECRET_KEY=sq7HjrUOBfKmC576ILgskD5srU870gJ7
REDSYS_ENVIRONMENT=test
# Must be a publicly reachable URL in any environment other than local dev,
# since Redsys' servers POST the payment result here directly.
REDSYS_NOTIFICATION_URL=http://localhost:3000/payments/redsys/notify
STOREFRONT_URL=http://localhost:3001

# --- Invoicing ---
# The store's real, registered fiscal identity. Confirm with a tax advisor
# before relying on this for real invoices — see InvoicingPlugin's doc
# comment for what this plugin does not yet handle (Veri*Factu, rectifying
# invoices, customer tax IDs, etc).
INVOICE_STORE_NAME=Tienda Suple
INVOICE_STORE_TAX_ID=B00000000
INVOICE_STORE_ADDRESS=Calle Ejemplo 1, 28001 Madrid, España
INVOICE_STORE_EMAIL=facturacion@example.com
