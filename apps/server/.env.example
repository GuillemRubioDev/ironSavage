# APP_ENV también afecta a `npm run seed` (apps/server/src/seed.ts): el método
# de pago de pruebas "standard-payment" solo se crea fuera de "production".
APP_ENV=dev
VENDURE_SERVER_PORT=3000
COOKIE_SECRET=replace-with-a-random-secret
# SUPERADMIN_USERNAME/PASSWORD son también el usuario con el que actúa
# `npm run seed` (busca este administrador para tener los permisos necesarios).
# No hay que crearlo antes: Vendure lo crea solo en cualquier arranque,
# incluido el del propio seed.
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=replace-with-a-strong-password
DB_HOST=localhost
DB_PORT=6543
DB_NAME=vendure
DB_USERNAME=vendure
DB_PASSWORD=replace-with-a-strong-password
DB_SCHEMA=public

# --- Solo producción (obligatorio cuando APP_ENV no es "dev") ---
# Orígenes, separados por comas, que pueden hacer peticiones con credenciales
# a las APIs Admin/Shop. Si no se define, se usa solo STOREFRONT_URL.
CORS_ORIGIN=https://www.your-shop.com
# URL pública base desde la que se sirven los recursos (imágenes). Obligatoria
# en producción: sin ella, las URLs de las imágenes salen rotas.
ASSET_URL_PREFIX=https://api.your-shop.com/assets/

# --- Redsys (TPV Virtual) ---
# Nunca pongas aquí credenciales reales de producción ni en un .env del repo.
# Estos valores son el comercio de pruebas que Redsys publica en su
# documentación: se pueden usar tal cual contra sis-t.redsys.es con REDSYS_ENVIRONMENT=test.
REDSYS_MERCHANT_CODE=999008881
REDSYS_TERMINAL=1
REDSYS_SECRET_KEY=sq7HjrUOBfKmC576ILgskD5srU870gJ7
REDSYS_ENVIRONMENT=test
# Fuera del desarrollo local debe ser una URL accesible desde internet:
# los servidores de Redsys envían aquí el resultado del pago (POST).
REDSYS_NOTIFICATION_URL=http://localhost:3000/payments/redsys/notify
STOREFRONT_URL=http://localhost:3001

# --- Facturación ---
# Identidad fiscal real y registrada de la tienda. Confírmala con la gestoría
# antes de emitir facturas reales. El comentario de InvoicingPlugin explica lo
# que aún queda pendiente (envío a Veri*Factu, NIF del cliente, etc.).
INVOICE_STORE_NAME=Tienda Suple
INVOICE_STORE_TAX_ID=B00000000
INVOICE_STORE_ADDRESS=Calle Ejemplo 1, 28001 Madrid, España
INVOICE_STORE_EMAIL=facturacion@example.com

# --- Emails automáticos ---
# Proveedor: "dev" (por defecto) guarda los emails como archivos en
# static/transactional-emails/ y no envía nada; "smtp" envía con los SMTP_* de abajo.
# En producción, dejarlo sin configurar (o a medias) significa que los emails de
# verificación y de contraseña no llegan al cliente, sin error (ver production-safety.ts).
EMAIL_ENABLED=true
EMAIL_PROVIDER=dev
EMAIL_FROM="Tienda Suple <no-reply@example.com>"
EMAIL_REPLY_TO=soporte@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
