# APP_ENV also controls `npm run seed` (apps/server/src/seed.ts): it only
# creates the "standard-payment" dummy payment method outside "production".
APP_ENV=dev
VENDURE_SERVER_PORT=3000
COOKIE_SECRET=replace-with-a-random-secret
# SUPERADMIN_USERNAME/PASSWORD are also who `npm run seed` acts as (it looks
# up this Administrator to build a properly-authorized context). No separate
# step needed to create it first — Vendure auto-creates it on any bootstrap,
# including the seed script's own.
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=replace-with-a-strong-password
DB_HOST=localhost
DB_PORT=6543
DB_NAME=vendure
DB_USERNAME=vendure
DB_PASSWORD=replace-with-a-strong-password
DB_SCHEMA=public

# --- Production-only (required when APP_ENV is not "dev") ---
# Comma-separated list of origins allowed to make credentialed requests to
# the Admin/Shop APIs. Falls back to STOREFRONT_URL alone if unset.
CORS_ORIGIN=https://www.your-shop.com
# Public base URL assets are served from — required in production, since
# leaving it unset would serve broken image URLs.
ASSET_URL_PREFIX=https://api.your-shop.com/assets/

# --- Redsys (TPV Virtual) ---
# Never put real production credentials here or in a committed .env file.
# The values below are Redsys' own publicly documented sandbox/test merchant,
# safe to use as-is against sis-t.redsys.es while REDSYS_ENVIRONMENT=test.
REDSYS_MERCHANT_CODE=999008881
REDSYS_TERMINAL=1
REDSYS_SECRET_KEY=sq7HjrUOBfKmC576ILgskD5srU870gJ7
REDSYS_ENVIRONMENT=test
# Must be a publicly reachable URL in any environment other than local dev,
# since Redsys' servers POST the payment result here directly.
REDSYS_NOTIFICATION_URL=http://localhost:3000/payments/redsys/notify
STOREFRONT_URL=http://localhost:3001

# --- Invoicing ---
# The store's real, registered fiscal identity. Confirm with a tax advisor
# before relying on this for real invoices — see InvoicingPlugin's doc
# comment for what this plugin does not yet handle (Veri*Factu, rectifying
# invoices, customer tax IDs, etc).
INVOICE_STORE_NAME=Tienda Suple
INVOICE_STORE_TAX_ID=B00000000
INVOICE_STORE_ADDRESS=Calle Ejemplo 1, 28001 Madrid, España
INVOICE_STORE_EMAIL=facturacion@example.com

# --- Transactional email ---
# provider: "dev" (default) writes rendered emails to static/transactional-emails/
# and never delivers anything for real; "smtp" sends via the SMTP_* settings below.
# In production, leaving this unset (or incomplete) means real verification/
# password-reset emails silently never reach the customer — see production-safety.ts.
EMAIL_ENABLED=true
EMAIL_PROVIDER=dev
EMAIL_FROM="Tienda Suple <no-reply@example.com>"
EMAIL_REPLY_TO=soporte@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
