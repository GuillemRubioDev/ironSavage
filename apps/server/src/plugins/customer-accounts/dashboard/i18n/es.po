#: src/plugins/customer-accounts/dashboard/customer-account-access.tsx
msgid "Password changed. The customer was signed out of all devices."
msgstr "Contraseña cambiada. Se ha cerrado la sesión del cliente en todos sus dispositivos."

#: src/plugins/customer-accounts/dashboard/customer-account-access.tsx
msgid "Unknown error"
msgstr "Error desconocido"

#: src/plugins/customer-accounts/dashboard/customer-account-access.tsx
msgid "Save password"
msgstr "Guardar contraseña"

#: src/plugins/customer-accounts/dashboard/customer-account-access.tsx
msgid "Account verified — the customer can sign in with their password."
msgstr "Cuenta verificada: el cliente ya puede iniciar sesión con su contraseña."

#: src/plugins/customer-accounts/dashboard/customer-account-access.tsx
msgid "Verify this account now"
msgstr "Verificar esta cuenta ahora"

#: src/plugins/customer-accounts/dashboard/customer-account-access.tsx
msgid "Account verified. {email} was emailed a link to choose a password."
msgstr "Cuenta verificada. Se ha enviado a {email} un enlace para elegir contraseña."

#: src/plugins/customer-accounts/dashboard/customer-account-access.tsx
msgid "This customer only bought as a guest and has no login yet."
msgstr "Este cliente solo ha comprado como invitado y todavía no tiene acceso."

#: src/plugins/customer-accounts/dashboard/customer-account-access.tsx
msgid "Give it to the customer; they can change it anytime from their account (My account → Profile)."
msgstr "Dásela al cliente; puede cambiarla cuando quiera desde su cuenta (Mi cuenta → Perfil)."

#: src/plugins/customer-accounts/dashboard/index.tsx
msgid "Account access"
msgstr "Acceso a la cuenta"

#: src/plugins/customer-accounts/dashboard/customer-account-access.tsx
#: src/plugins/customer-accounts/dashboard/customer-account-access.tsx
msgid "Cancel"
msgstr "Cancelar"

#: src/plugins/customer-accounts/dashboard/customer-account-access.tsx
msgid "Password email sent to {email}"
msgstr "Email de contraseña enviado a {email}"

#: src/plugins/customer-accounts/dashboard/customer-account-access.tsx
msgid "Set a temporary password (the customer can sign in right away)"
msgstr "Poner una contraseña temporal (el cliente puede entrar al momento)"

#: src/plugins/customer-accounts/dashboard/customer-account-access.tsx
#: src/plugins/customer-accounts/dashboard/customer-account-access.tsx
msgid "Change password"
msgstr "Cambiar contraseña"

#: src/plugins/customer-accounts/dashboard/customer-account-access.tsx
msgid "Copy"
msgstr "Copiar"

#: src/plugins/customer-accounts/dashboard/customer-account-access.tsx
msgid "Keep the password the customer already chose"
msgstr "Mantener la contraseña que ya eligió el cliente"

#: src/plugins/customer-accounts/dashboard/customer-account-access.tsx
msgid "Password set"
msgstr "Con contraseña"

#: src/plugins/customer-accounts/dashboard/customer-account-access.tsx
msgid "Create login & send activation email"
msgstr "Crear acceso y enviar email de activación"

#: src/plugins/customer-accounts/dashboard/customer-account-access.tsx
msgid "Action failed"
msgstr "La acción ha fallado"

#: src/plugins/customer-accounts/dashboard/customer-account-access.tsx
msgid "Saving…"
msgstr "Guardando…"

#: src/plugins/customer-accounts/dashboard/customer-account-access.tsx
msgid "Email the customer a link to choose their own password"
msgstr "Enviar al cliente un enlace para que elija su contraseña"

#: src/plugins/customer-accounts/dashboard/customer-account-access.tsx
msgid "No login (guest)"
msgstr "Sin acceso (invitado)"

#: src/plugins/customer-accounts/dashboard/customer-account-access.tsx
msgid "Send password reset email"
msgstr "Enviar email para restablecer la contraseña"

