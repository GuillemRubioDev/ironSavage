msgid "Resend activation email"
msgstr "Reenviar email de activación"

#: src/plugins/customer-accounts/dashboard/customer-account-access.tsx
msgid "Verified"
msgstr "Verificado"

#: src/plugins/customer-accounts/dashboard/customer-account-access.tsx
msgid "Verifying…"
msgstr "Verificando…"

#: src/plugins/customer-accounts/dashboard/customer-account-access.tsx
msgid "Password copied"
msgstr "Contraseña copiada"

#: src/plugins/customer-accounts/dashboard/customer-account-access.tsx
msgid "Last sign-in: {lastLogin}"
msgstr "Último acceso: {lastLogin}"

#: src/plugins/customer-accounts/dashboard/customer-account-access.tsx
msgid "Not verified"
msgstr "Sin verificar"

#: src/plugins/customer-accounts/dashboard/customer-account-access.tsx
msgid "Send \"create your password\" email"
msgstr "Enviar email «crea tu contraseña»"

#: src/plugins/customer-accounts/dashboard/customer-account-access.tsx
msgid "Verify"
msgstr "Verificar"

#: src/plugins/customer-accounts/dashboard/customer-account-access.tsx
msgid "Temporary password"
msgstr "Contraseña temporal"

#: src/plugins/customer-accounts/dashboard/customer-account-access.tsx
msgid "Activation email sent to {email}"
msgstr "Email de activación enviado a {email}"

#: src/plugins/customer-accounts/dashboard/customer-account-access.tsx
msgid "The customer will be signed out of all their devices."
msgstr "Se cerrará la sesión del cliente en todos sus dispositivos."

#: src/plugins/customer-accounts/dashboard/customer-account-access.tsx
msgid "No password yet"
msgstr "Aún sin contraseña"

#: src/plugins/customer-accounts/dashboard/customer-account-access.tsx
msgid "Verify now"
msgstr "Verificar ahora"

#: src/plugins/customer-accounts/dashboard/customer-account-access.tsx
msgid "8+ chars"
msgstr "Mín. 8"

#: src/plugins/customer-accounts/dashboard/customer-account-access.tsx
