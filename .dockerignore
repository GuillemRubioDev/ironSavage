# Se aplica a cualquier `docker build` que use la raíz del repo como contexto
# (lo usan tanto apps/server/Dockerfile como apps/storefront/Dockerfile).
**/node_modules
**/dist
**/.next
**/admin-ui
.git
.vscode
.claude
*.log

# Nunca meter secretos ni configuración real en una capa de la imagen.
**/.env
**/.env.local
!**/.env.example

# Datos que se escriben en ejecución: van en volúmenes, no en capas de la imagen.
apps/server/static/assets
apps/server/static/email
apps/server/static/invoices
apps/server/static/transactional-emails

# No hacen falta en el contexto de build.
**/*.md
apps/storefront/tests
apps/storefront/coverage
