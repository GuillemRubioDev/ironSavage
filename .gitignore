node_modules
.env
.env.local
.env.prod
!.env.prod.example
*.log
.DS_Store
.claude

# Copias de seguridad (scripts/backup.sh): contienen datos reales de clientes y pedidos; nunca se suben.
backups/

# Identificador local de máquina del CLI de Vendure, usado solo para su telemetría
# anónima. Se regenera solo y no debe compartirse entre máquinas.
/.vendure/

# Carpeta temporal/caché de TanStack Router, generada al compilar o servir el
# dashboard de @vendure/dashboard (apps/server). Se puede borrar; se regenera
# en el siguiente build o dev.
apps/server/.tanstack/

# Capturas de red/consola del navegador hechas al depurar en local; no se suben.
/_debug-postbodies.txt

# Archivos que scripts/deploy.sh deja en el servidor: la copia del script que se
# ejecuta (.deploy.sh, la extrae deploy.yml de la rama a desplegar) y el commit
# desplegado (.deployed-sha).
/.deploy.sh
/.deployed-sha

# Maquetas del asistente de diseño (brainstorming visual); solo para trabajar en local.
/.superpowers/

# Copias temporales de verificación del storefront (build de Next en local): nunca se suben.
/tmp-*/
